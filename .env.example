# X public-data access. Never commit the real value.
X_BEARER_TOKEN=

# Pooled PostgreSQL connection string from Supabase, Neon, or another provider.
DATABASE_URL=

# Long random strings. Vercel automatically includes CRON_SECRET in cron calls.
CRON_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: enables AI scoring for newly followed accounts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
