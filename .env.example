# X public-data access. Never commit the real value.
X_BEARER_TOKEN=

# PostgreSQL connection string.
# On Supabase use the SESSION pooler: pooler hostname, port 5432, ?sslmode=require.
# The transaction pooler (6543) hangs with this driver, and the direct host is
# IPv6-only. See the Supabase note in README.md.
DATABASE_URL=

# Long random strings. Vercel automatically includes CRON_SECRET in cron calls.
CRON_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: enables AI scoring for newly followed accounts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: canonical site URL for social share images.
# Defaults to the Vercel production domain, then to http://localhost:3000.
SITE_URL=
